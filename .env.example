# HermesForge ortam değişkenleri (hepsi isteğe bağlı).
# Kalıcı ayarlar ~/.hermesforge/config.json içinde de tutulabilir.
#
# Uygulama yalnızca Hermes Agent ile çalışır; model, sağlayıcı ve model
# anahtarı Hermes tarafında (~/.hermes/config.yaml) yaşar, burada değil.

# --- Hermes Agent API sunucusu ---
# API_SERVER_KEY normalde ~/.hermes/.env içinden otomatik okunur.
# API_SERVER_KEY=hf-...
# HERMESFORGE_HERMES_URL=http://192.168.1.20:8642
# HERMESFORGE_HERMES_MODEL=hermes-agent
# HERMESFORGE_HERMES_REPO=/veri/hermes-agent
# HERMESFORGE_HERMES_AUTOSTART=true

# --- Model davranışı ---
# HERMESFORGE_REASONING_EFFORT=default
# HERMESFORGE_MAX_TOKENS=32768
# HERMESFORGE_MAX_PARALLEL=2

# --- Web sunucusu ---
# HERMESFORGE_HOST=127.0.0.1
# HERMESFORGE_PORT=5000
