{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.skitter": {
      "arrays": {
        "geometries": {
          "Array.styles": [
            "Geometry.widow",
            "Geometry.husk"
          ]
        },
        "textures": {
          "Array.skins": [
            "Texture.widow",
            "Texture.husk"
          ]
        }
      },
      "geometry": "Array.styles[query.property('skitter:style') == 'husk']",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('skitter:style') == 'husk']"
      ]
    }
  }
}